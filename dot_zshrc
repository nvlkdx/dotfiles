# zsh
export ZSH="$HOME/.oh-my-zsh"

# theming
ZSH_THEME="vira"
COMPLETION_WAITING_DOTS="true"

# plugins
plugins=(git)

# some bullshit
# DISABLE_UNTRACKED_FILES_DIRTY="true"
HIST_STAMPS="dd.mm.yy"

# scripting
source $ZSH/oh-my-zsh.sh
if [[ $TERM = "xterm-kitty" ]]; then ~/.config/kitty/startup.sh; fi

# environment
source $ZSH_CUSTOM/als.zsh
source $ZSH_CUSTOM/env.zsh

# termsaver
whence -p drift &>/dev/null && eval "$(drift shell-init zsh)"

# greetings and salutations
whence -p figlet &>/dev/null && { echo && figlet -cf "$(shuf -n 1 $ZSH_CUSTOM/zsh-greet-fonts)" -w "$COLUMNS" "$(shuf -n 1 $ZSH_CUSTOM/zsh-greets)" }
