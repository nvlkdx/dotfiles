#!/bin/zsh

cmd=("$@")

if [[ $#cmd -gt 1 ]]; then
	echo "[sid!] too many arguments\n[sid/] aborting"; exit 1; 
elif [[ $cmd[1] == <1-5> ]]; then
	T=${cmd[1]}
else
	if [[ $#cmd -eq 1 ]]; then
		echo "[sid.] makeshift sidonia theme switcher"
		echo "[sid,] put themes at /boot/grub/themes/sid[1-5]"
		echo "[sid,] set size with \$SIDONIA_THEME_SIZE at ~/.env/"
		echo "[sid,] run either with theme number as sole argument"
		echo "[sid,] or without args for a random theme"
		exit 0
	else
		T="$(shuf -n 1 -i 1-5)"
	fi
fi

! (( ${+SIDONIA_THEME_SIZE} )) && source ~/.env/SIDONIA_THEME_SIZE &>/dev/null
S=${SIDONIA_THEME_SIZE:="1440"}

if [[ $T -eq 5 ]]; then
	F='ui.pf2'
else
	F="sidonia-t${T}-${S}p.pf2"
fi

sudo sed -i "s|^GRUB_THEME=.*|GRUB_THEME=\"/boot/grub/themes/sid${T}/${S}p/theme.txt\"|; s|^GRUB_FONT=.*|GRUB_FONT=\"/boot/grub/themes/sid${T}/${S}p/fonts/${F}\"|; s|^GRUB_GFXMODE=.*|GRUB_GFXMODE=\"$(( (S / 0.5625) | 0 ))x${S}\"|; s|^GRUB_TERMINAL_OUTPUT=.*|GRUB_TERMINAL_OUTPUT=\"gfxterm\"|; s|^GRUB_GFXPAYLOAD_LINUX=.*|GRUB_GFXPAYLOAD_LINUX=keep|" /etc/default/grub && sudo grub-mkconfig -o /boot/grub/grub.cfg
